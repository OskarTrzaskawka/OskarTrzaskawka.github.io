# ─────────────────────────────────────────────────────────────────────────────
#  Persona Folio — environment configuration
#  Copy to `.env` (or `.env.local`) and fill in what you need.
#  Every variable is OPTIONAL. Empty = use the value from the persona file.
#
#  ⚠️  Everything prefixed with VITE_ is PUBLIC — it ends up in the browser
#      bundle. Never put secrets, API keys or tokens here.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Persona & look ────────────────────────────────────────────────────────
# Which file from src/personas/ to build: developer | designer | photographer | minimal | <your-own>
VITE_PERSONA=developer
# Force a template regardless of the persona: developer | designer | photographer | minimal
VITE_TEMPLATE=
# Initial color scheme: dark | light | system   (visitors can still toggle)
VITE_DEFAULT_SCHEME=
# Accent colors — any CSS color: #ff5a36, oklch(0.8 0.2 150), rebeccapurple…
VITE_ACCENT_COLOR=
VITE_ACCENT_COLOR_2=
# Bundle ALL personas and show the floating persona switcher (great for demos)
VITE_SHOWCASE=false

# ── 2. Identity ──────────────────────────────────────────────────────────────
VITE_NAME=
# Shown in the nav (defaults to VITE_NAME)
VITE_SHORT_NAME=
VITE_ROLE=
VITE_LOCATION=
# IANA time zone for the live local clock, e.g. Europe/Warsaw, America/New_York
VITE_TIMEZONE=
VITE_EMAIL=
# Root-relative path in /public (e.g. /me.jpg) or a full URL. Empty = initials.
VITE_AVATAR_URL=
# Adds a "Download CV" button. e.g. /cv.pdf
VITE_RESUME_URL=
# open | limited | closed | hidden
VITE_AVAILABILITY=
VITE_AVAILABILITY_LABEL=

# ── 3. Hero ──────────────────────────────────────────────────────────────────
# Use *asterisks* to highlight words and \n for line breaks
VITE_HERO_TITLE=
VITE_HERO_SUBTITLE=

# ── 4. Social links (full URLs) ──────────────────────────────────────────────
# Also powers the live GitHub section (repos, stars, contribution graph)
VITE_GITHUB_USERNAME=
VITE_LINKEDIN_URL=
VITE_X_URL=
VITE_BLUESKY_URL=
VITE_MASTODON_URL=
VITE_INSTAGRAM_URL=
VITE_DRIBBBLE_URL=
VITE_BEHANCE_URL=
VITE_YOUTUBE_URL=
VITE_VIMEO_URL=
VITE_DISCORD_URL=
VITE_MEDIUM_URL=
VITE_FACEBOOK_URL=

# ── 5. Sections ──────────────────────────────────────────────────────────────
# Comma-separated section types or ids to hide, e.g. terminal,github,testimonials
VITE_HIDE_SECTIONS=
# Comma-separated order; unlisted sections keep their order at the end
# e.g. about,work,skills,contact
VITE_SECTION_ORDER=

# ── 6. Features (true/false) ─────────────────────────────────────────────────
VITE_FEATURE_COMMAND_PALETTE=true
VITE_FEATURE_THEME_TOGGLE=true
VITE_FEATURE_SCROLL_PROGRESS=true
VITE_FEATURE_CURSOR_GLOW=true
VITE_FEATURE_ANIMATIONS=true
VITE_FEATURE_CONTACT_FORM=true
VITE_FEATURE_LOCAL_TIME=true
VITE_FEATURE_BACK_TO_TOP=true
VITE_FEATURE_GRAIN=true

# ── 7. SEO & deployment ──────────────────────────────────────────────────────
# Public URL without trailing slash — enables canonical, og:url and sitemap.xml
VITE_SITE_URL=
VITE_SITE_TITLE=
VITE_SITE_DESCRIPTION=
# 1200×630 image, path in /public or full URL
VITE_OG_IMAGE=
# Sub-path for GitHub Pages project sites, e.g. /my-portfolio/  (default /)
VITE_BASE=/

# ── 8. Integrations ──────────────────────────────────────────────────────────
# Contact form endpoint (Formspree, Web3Forms, Getform, Basin…). Empty = opens the visitor's mail app.
VITE_CONTACT_ENDPOINT=
# Public access key for services that need one, e.g. Web3Forms (https://api.web3forms.com/submit)
VITE_CONTACT_ACCESS_KEY=
# Cookieless analytics (no consent banner required)
VITE_PLAUSIBLE_DOMAIN=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=
